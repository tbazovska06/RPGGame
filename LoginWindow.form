<component class="javax.swing.JPanel" name="loginPanel">
  <constraints>
    <xy x="20" y="20" width="500" height="300"/>
  </constraints>
  <properties/>
  <children>
    <component class="javax.swing.JLabel" name="titleLabel">
      <properties>
        <text value="E-Shop"/>
        <font name="Segoe UI" size="26" style="1"/>
        <foreground color="50,120,255"/>
      </properties>
      <constraints>
        <xy x="20" y="10" width="200" height="40"/>
      </constraints>
    </component>
    <component class="javax.swing.JLabel" name="emailLabel">
      <properties>
        <text value="Email:"/>
      </properties>
      <constraints>
        <xy x="50" y="60" width="100" height="20"/>
      </constraints>
    </component>
    <component class="javax.swing.JTextField" name="emailField">
      <constraints>
        <xy x="50" y="80" width="180" height="30"/>
      </constraints>
    </component>
    <component class="javax.swing.JLabel" name="passwordLabel">
      <properties>
        <text value="Password:"/>
      </properties>
      <constraints>
        <xy x="50" y="120" width="100" height="20"/>
      </constraints>
    </component>
    <component class="javax.swing.JPasswordField" name="passwordField">
      <constraints>
        <xy x="50" y="140" width="180" height="30"/>
      </constraints>
    </component>
    <component class="javax.swing.JCheckBox" name="rememberMeBox">
      <properties>
        <text value="Remember me"/>
      </properties>
      <constraints>
        <xy x="50" y="180" width="130" height="20"/>
      </constraints>
    </component>
    <component class="javax.swing.JLabel" name="forgotLabel">
      <properties>
        <text value="Forgot password"/>
        <foreground color="0,0,255"/>
      </properties>
      <constraints>
        <xy x="180" y="180" width="130" height="20"/>
      </constraints>
    </component>
    <component class="javax.swing.JButton" name="loginButton">
      <properties>
        <text value="Login"/>
      </properties>
      <constraints>
        <xy x="50" y="210" width="180" height="30"/>
      </constraints>
    </component>
    <component class="javax.swing.JLabel" name="registerLabel">
      <properties>
        <text value="Or register now!"/>
        <foreground color="100,100,255"/>
      </properties>
      <constraints>
        <xy x="80" y="250" width="200" height="20"/>
      </constraints>
    </component>
  </children>
</component>
